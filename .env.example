# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sui_dhaga?schema=public"

# Session secret — used to sign/encrypt the admin session cookie.
# Generate a strong random value locally, e.g.:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# Seed script only — used once to create the single admin account.
# Not read anywhere else in the app. Remove/rotate after first seed.
SEED_ADMIN_EMAIL="admin@suidhaga.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
