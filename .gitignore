# dependencies
/node_modules

# next.js
/.next/
# Every isolated test build dir (NEXT_DIST_DIR in next.config.mjs): the
# plain /.next-test/, plus the per-scenario ones like
# .next-test-browser/ that a targeted test run creates.
/.next-test*/
/out/

# production
/build

# env files — never commit real secrets
.env
.env*.local
# Step 54 — isolated test-database credentials (same shape as .env; see
# scripts/README.md). Never committed, exactly like .env itself.
.env.test

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts
